# Maximum upload file size in megabytes
# Sizing rule: tmpfs size must be >= (MAX_CONCURRENCY * MAX_UPLOAD_MB) + ~200 MB headroom.
# In Linux Docker, tmpfs memory counts directly against the container's mem_limit.
# (Note: Cloudflare free plan caps bodies at 100 MB; values >100 MB apply when LAN access is added).
MAX_UPLOAD_MB=1024

# Per-file conversion timeout in seconds
# (Note: Cloudflare free plan drops connections after ~100 s with HTTP 524; values >100 s apply to direct/LAN access).
CONVERT_TIMEOUT_S=600

# Maximum number of concurrent conversions and uploads handled simultaneously
# Sizing rule: Concurrency gates how many large uploads can occupy /tmp tmpfs simultaneously.
# With MAX_CONCURRENCY=1 and MAX_UPLOAD_MB=1024, tmpfs needs ~1300 MB, fitting within 3 GB mem_limit.
MAX_CONCURRENCY=1

# Default frontend and API setting for prepending YAML frontmatter
ENABLE_FRONTMATTER_DEFAULT=true

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Application root path prefix if mounted behind a reverse proxy subpath
ROOT_PATH=
